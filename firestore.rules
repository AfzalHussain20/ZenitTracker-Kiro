rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isLead() {
        return request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'lead';
    }

    // Sun Network staff. Used to protect company-wide collections while
    // external accounts can still use their own sessions and notes.
    function isInternal() {
        return request.auth != null
            && request.auth.token.email is string
            && request.auth.token.email.matches('.*@sunnetwork[.]in$');
    }

    function changedKeys() {
        return request.resource.data.diff(resource.data).affectedKeys();
    }

    // True when the caller is an invited tester on this session.
    function isSessionTester() {
        return request.auth != null
            && request.auth.uid in resource.data.get('testerIds', []);
    }

    // Owner, invited tester, or lead may read; anyone (guest) may read a shared,
    // finished session so the public /report/{id} link works without login.
    function canReadSharedSession() {
        return (request.auth != null && (request.auth.uid == resource.data.userId || isSessionTester() || isLead()))
            || resource.data.status == 'Completed'
            || resource.data.status == 'Aborted';
    }

    // Owner, invited tester, or lead may update an in-progress session.
    // Owner-only for create/delete; anyone (incl. guests) can read finished sessions.
    function canWriteSession() {
        return request.auth != null
            && (request.auth.uid == resource.data.userId || isSessionTester() || isLead());
    }

    match /users/{userId} {
      allow read: if request.auth.uid == userId || isLead();
      // A user may create their own profile, but cannot grant themselves a
      // privileged role or a paid plan. Only staff may start on enterprise.
      allow create: if request.auth.uid == userId
        && request.resource.data.uid == userId
        && request.resource.data.role == 'tester'
        && (request.resource.data.plan == 'free'
            || (isInternal() && request.resource.data.plan == 'enterprise'));
      // Role, plan and org membership are server-managed. Without this, any
      // signed-in user could promote themselves to lead or enterprise.
      allow update: if request.auth.uid == userId
        && !changedKeys().hasAny(['role', 'plan', 'orgId', 'orgRole', 'orgName', 'subscription']);
      allow delete: if isLead();
    }
    
    match /testSessions/{sessionId} {
      allow read: if canReadSharedSession();
      allow create, delete: if request.auth.uid == request.resource.data.userId;
      allow update: if canWriteSession();
    }

    match /sessions/{sessionId} {
      allow read: if canReadSharedSession();
      allow create, delete: if request.auth.uid == request.resource.data.userId;
      allow update: if canWriteSession();
    }

    match /managedTestCases/{testCaseId} {
        allow read, write: if isInternal();
    }

    match /tasks/{taskId} {
      // Leads can do everything; testers can read tasks assigned to them and update status
      allow read: if request.auth.uid == resource.data.assignedToUid || isLead();
      allow create, delete: if isLead();
      allow update: if isLead() || request.auth.uid == resource.data.assignedToUid;
    }

    match /bugs/{bugId} {
      allow read, write: if isInternal();
    }

    match /testCaseGenerations/{pageId} {
      allow read, write: if request.auth != null;
      
      match /testCases/{testCaseId} {
        allow read, write: if request.auth != null;
      }
    }

    // Test Repository (shared suite library). Missing rules previously caused
    // "No test suites" and failures to add/update/delete suites.
    match /testSuites/{suiteId} {
      allow read, write: if request.auth != null;
    }

    // Test-suite plans and their cases.
    match /test_plans/{planId} {
      allow read, write: if request.auth != null;
    }

    match /test_cases/{caseId} {
      allow read, write: if request.auth != null;
    }

    // Worklogs and cached team metrics used by the KPI/analytics screens.
    // These contain company-wide performance data.
    match /worklogs/{worklogId} {
      allow read, write: if isInternal();
    }

    match /team_metrics_cache/{cacheId} {
      allow read, write: if isInternal();
    }

    // Keepr device registry and audit log (company hardware).
    match /keepr_devices/{deviceId} {
      allow read, write: if isInternal();
    }

    match /keepr_history/{historyId} {
      allow read, write: if isInternal();
    }

    match /keepr_audit_logs/{logId} {
      allow read, write: if isInternal();
    }

    // Certificates back the public /verify/{id} page, so reads must be public.
    match /certificates/{certId} {
      allow read: if true;
      allow write: if isInternal();
    }
  }
}