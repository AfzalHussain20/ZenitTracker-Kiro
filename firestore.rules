rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isLead() {
        return request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'lead';
    }

    // True when the caller is an invited tester on this session.
    function isSessionTester() {
        return request.auth != null
            && request.auth.uid in resource.data.get('testerIds', []);
    }

    // Owner, invited tester, or lead may read; anyone (guest) may read a shared,
    // finished session so the public /report/{id} link works without login.
    function canReadSharedSession() {
        return (request.auth != null && (request.auth.uid == resource.data.userId || isSessionTester() || isLead()))
            || resource.data.status == 'Completed'
            || resource.data.status == 'Aborted';
    }

    // Owner, invited tester, or lead may update an in-progress session.
    // Owner-only for create/delete; anyone (incl. guests) can read finished sessions.
    function canWriteSession() {
        return request.auth != null
            && (request.auth.uid == resource.data.userId || isSessionTester() || isLead());
    }

    match /users/{userId} {
      allow read: if request.auth.uid == userId || isLead();
      allow write: if request.auth.uid == userId;
    }
    
    match /testSessions/{sessionId} {
      allow read: if canReadSharedSession();
      allow create, delete: if request.auth.uid == request.resource.data.userId;
      allow update: if canWriteSession();
    }

    match /sessions/{sessionId} {
      allow read: if canReadSharedSession();
      allow create, delete: if request.auth.uid == request.resource.data.userId;
      allow update: if canWriteSession();
    }

    match /managedTestCases/{testCaseId} {
        allow read, write: if request.auth != null;
    }

    match /tasks/{taskId} {
      // Leads can do everything; testers can read tasks assigned to them and update status
      allow read: if request.auth.uid == resource.data.assignedToUid || isLead();
      allow create, delete: if isLead();
      allow update: if isLead() || request.auth.uid == resource.data.assignedToUid;
    }

    match /bugs/{bugId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null;
    }

    match /testCaseGenerations/{pageId} {
      allow read, write: if request.auth != null;
      
      match /testCases/{testCaseId} {
        allow read, write: if request.auth != null;
      }
    }
  }
}